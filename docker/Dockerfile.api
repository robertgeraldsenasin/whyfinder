# The REST API (FR-21; ADR-0019): the glass-box model on the committed demo slice and the review
# index over its quotes (ADR-0010), behind uvicorn. Start-up indexes the reviews (about 20 s).
#   docker build -f docker/Dockerfile.api --build-arg GIT_SHA=$(git rev-parse HEAD) -t whyfinder-api .
#   docker run -p 8000:8000 whyfinder-api
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
# Dependencies first so code changes reuse the layer.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --group serve --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev --group serve
COPY params.yaml ./
COPY web/public/data/demo-slice.json web/public/data/reviews.json ./web/public/data/

ARG GIT_SHA=unknown
ENV WHYFINDER_GIT_SHA=${GIT_SHA} \
    PATH="/app/.venv/bin:${PATH}"
RUN useradd --create-home --uid 10001 whyfinder
USER whyfinder

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s \
  CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/healthz', timeout=2)"
CMD ["whyfinder", "serve", "run", "--host", "0.0.0.0", "--port", "8000"]
