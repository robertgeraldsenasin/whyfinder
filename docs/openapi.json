{
  "components": {
    "schemas": {
      "Attribution": {
        "properties": {
          "contribution": {
            "title": "Contribution",
            "type": "number"
          },
          "ease_part": {
            "title": "Ease Part",
            "type": "number"
          },
          "game_id": {
            "title": "Game Id",
            "type": "string"
          },
          "ppr_part": {
            "title": "Ppr Part",
            "type": "number"
          },
          "share": {
            "title": "Share",
            "type": "number"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "game_id",
          "title",
          "contribution",
          "share",
          "ease_part",
          "ppr_part"
        ],
        "title": "Attribution",
        "type": "object"
      },
      "AttributionEvidence": {
        "properties": {
          "game_id": {
            "title": "Game Id",
            "type": "string"
          },
          "share": {
            "title": "Share",
            "type": "number"
          },
          "type": {
            "const": "attribution",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "game_id",
          "share"
        ],
        "title": "AttributionEvidence",
        "type": "object"
      },
      "Checker": {
        "properties": {
          "fallback_used": {
            "title": "Fallback Used",
            "type": "boolean"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          }
        },
        "required": [
          "passed",
          "fallback_used",
          "reasons"
        ],
        "title": "Checker",
        "type": "object"
      },
      "Claim": {
        "properties": {
          "evidence": {
            "items": {
              "discriminator": {
                "mapping": {
                  "attribution": "#/components/schemas/AttributionEvidence",
                  "counterfactual": "#/components/schemas/CounterfactualEvidence",
                  "review": "#/components/schemas/ReviewEvidence"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/AttributionEvidence"
                },
                {
                  "$ref": "#/components/schemas/ReviewEvidence"
                },
                {
                  "$ref": "#/components/schemas/CounterfactualEvidence"
                }
              ]
            },
            "title": "Evidence",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "evidence"
        ],
        "title": "Claim",
        "type": "object"
      },
      "CounterfactualEvidence": {
        "properties": {
          "removed_game_ids": {
            "items": {
              "type": "string"
            },
            "title": "Removed Game Ids",
            "type": "array"
          },
          "type": {
            "const": "counterfactual",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "removed_game_ids"
        ],
        "title": "CounterfactualEvidence",
        "type": "object"
      },
      "CounterfactualOut": {
        "properties": {
          "guarantee": {
            "enum": [
              "irreducible",
              "exact_min",
              "not_in_picks"
            ],
            "title": "Guarantee",
            "type": "string"
          },
          "pipeline_runs": {
            "title": "Pipeline Runs",
            "type": "integer"
          },
          "removed_game_ids": {
            "items": {
              "type": "string"
            },
            "title": "Removed Game Ids",
            "type": "array"
          }
        },
        "required": [
          "removed_game_ids",
          "guarantee",
          "pipeline_runs"
        ],
        "title": "CounterfactualOut",
        "type": "object"
      },
      "ExplainIn": {
        "additionalProperties": false,
        "anyOf": [
          {
            "properties": {
              "liked_game_ids": {
                "minItems": 1
              }
            },
            "required": [
              "liked_game_ids"
            ]
          },
          {
            "required": [
              "query"
            ]
          }
        ],
        "properties": {
          "filters": {
            "$ref": "#/components/schemas/FiltersIn"
          },
          "game_id": {
            "examples": [
              "367520"
            ],
            "pattern": "^[0-9]{1,10}$",
            "title": "Game Id",
            "type": "string"
          },
          "liked_game_ids": {
            "items": {
              "examples": [
                "367520"
              ],
              "pattern": "^[0-9]{1,10}$",
              "type": "string"
            },
            "maxItems": 50,
            "title": "Liked Game Ids",
            "type": "array"
          },
          "query": {
            "anyOf": [
              {
                "maxLength": 300,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query"
          }
        },
        "required": [
          "game_id"
        ],
        "title": "ExplainIn",
        "type": "object"
      },
      "ExplainOut": {
        "properties": {
