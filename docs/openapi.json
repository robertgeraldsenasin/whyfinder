            "type": "boolean"
          },
          "filters": {
            "$ref": "#/components/schemas/FiltersIn"
          },
          "k": {
            "default": 10,
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "K",
            "type": "integer"
          },
          "liked_game_ids": {
            "items": {
              "examples": [
                "367520"
              ],
              "pattern": "^[0-9]{1,10}$",
              "type": "string"
            },
            "maxItems": 50,
            "title": "Liked Game Ids",
            "type": "array"
          },
          "query": {
            "anyOf": [
              {
                "maxLength": 300,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query"
          }
