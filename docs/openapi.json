            "type": "array"
          },
          "year_max": {
            "anyOf": [
              {
                "maximum": 2100.0,
                "minimum": 1970.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year Max"
          },
          "year_min": {
            "anyOf": [
              {
                "maximum": 2100.0,
                "minimum": 1970.0,
                "type": "integer"
