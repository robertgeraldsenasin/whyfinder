{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robertgeraldsenasin/whyfinder/docs/spec/claim.schema.json",
  "title": "Claims about one recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claims"
  ],
  "properties": {
    "claims": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidence"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "game_id",
                    "share"
                  ],
                  "properties": {
                    "type": {
                      "const": "attribution"
                    },
                    "game_id": {
                      "type": "string"
                    },
                    "share": {
                      "type": "number"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "chunk_id",
                    "quote"
                  ],
                  "properties": {
                    "type": {
                      "const": "review"
                    },
                    "chunk_id": {
                      "type": "string"
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "removed_game_ids"
                  ],
                  "properties": {
                    "type": {
                      "const": "counterfactual"
                    },
                    "removed_game_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
