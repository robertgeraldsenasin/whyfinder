{
  "name": "whyfinder-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Star-atlas demo for Whyfinder: the glass-box engine running live in the browser (ADR-0015).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "e2e": "playwright test",
    "screens": "WHYFINDER_SCREENS=1 playwright test screens",
    "gif": "WHYFINDER_GIF=1 playwright test gif --project=desktop"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/prata": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^24.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
